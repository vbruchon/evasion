// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum AccommodationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Accommodation {
  id String @id @default(cuid())

  name             String
  slug             String  @unique
  type             String?
  subtitle         String?
  shortDescription String? @db.Text
  description      String? @db.Text

  guestCapacity Int?
  bedrooms      Int?
  beds          Int?
  bathrooms     Int?
  surface       Float?

  locationTitle        String?
  locationDescription  String? @db.Text
  locationLatitude     Float?
  locationLongitude    Float?
  locationRadiusMeters Int?

  availabilityCalendarUrl String?
  bookingUrl              String?

  availabilityTitle       String @default("Planifiez votre séjour")
  availabilityDescription String @default("Consultez les prochaines disponibilités du logement et choisissez les dates qui vous conviennent.")
  bookingButtonLabel      String @default("Continuer sur Airbnb")

  reviewsTitle        String                @default("Leurs moments, leurs mots")
  reviewsDescription  String                @default("Découvrez les impressions laissées par les voyageurs après leur séjour.")
  lastReviewsImportAt DateTime?
  reviews             AccommodationReview[]

  highlights AccommodationHighlight[]
  amenities  AccommodationAmenity[]
  accesses   AccommodationAccess[]

  status      AccommodationStatus @default(DRAFT)
  position    Int                 @default(0)
  publishedAt DateTime?

  images AccommodationImage[]

  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  draft     AccommodationDraft?

  @@index([status, position])
  @@map("accommodations")
}

model AccommodationImage {
  id             String  @id @default(cuid())
  url            String
  fileKey        String  @unique
  alt            String?
  caption        String?
  position       Int     @default(0)
  isCover        Boolean @default(false)
  isPresentation Boolean @default(false)

  accommodationId String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accommodationId, position])
  @@map("accommodation_images")
}

model AccommodationDraft {
  id String @id @default(cuid())

  content Json

  accommodationId String        @unique
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("accommodation_drafts")
}

model AccommodationHighlight {
  id String @id @default(cuid())

  title       String
  description String?
  icon        String
  position    Int     @default(0)

  accommodationId String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accommodationId, position])
  @@map("accommodation_highlights")
}

model AccommodationAmenity {
  id String @id @default(cuid())

  key      String
  details  String?
  position Int     @default(0)

  accommodationId String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accommodationId, key])
  @@index([accommodationId, position])
  @@map("accommodation_amenities")
}

model AccommodationAccess {
  id String @id @default(cuid())

  key     String
  details String?

  accommodationId String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accommodationId, key])
  @@index([accommodationId])
  @@map("accommodation_accesses")
}

model AccommodationReview {
  id              String @id @default(cuid())
  accommodationId String
  importKey       String

  authorName String
  rating     Int
  comment    String
  reviewedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accommodation Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  @@unique([accommodationId, importKey])
  @@index([accommodationId, reviewedAt])
}

model ReviewsPageContent {
  id String @id

  heroEyebrow               String
  heroTitle                 String
  heroDescription           String  @db.Text
  heroHandwrittenFirstLine  String
  heroHandwrittenSecondLine String
  heroImageUrl              String?
  heroImageFileKey          String?

  recentReviewsEyebrow     String
  recentReviewsTitle       String
  recentReviewsDescription String @db.Text

  allReviewsTitle       String
  allReviewsDescription String @db.Text

  ctaEyebrow              String
  ctaTitle                String
  ctaDescription          String  @db.Text
  ctaButtonLabel          String
  ctaHandwrittenPrefix    String
  ctaHandwrittenHighlight String
  ctaImageUrl             String?
  ctaImageFileKey         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reviews_page_content")
}

model AboutPageContent {
  id String @id

  heroEyebrow     String
  heroTitle       String
  heroDescription String @db.Text
  heroButtonLabel String

  spiritEyebrow         String
  spiritTitle           String
  spiritFirstParagraph  String  @db.Text
  spiritSecondParagraph String  @db.Text
  spiritHandwritten     String
  spiritImageUrl        String?
  spiritImageFileKey    String?

  philosophyEyebrow     String
  philosophyTitle       String
  philosophyDescription String @db.Text

  philosophyFirstTitle       String
  philosophyFirstDescription String @db.Text

  philosophySecondTitle       String
  philosophySecondDescription String @db.Text

  philosophyThirdTitle       String
  philosophyThirdDescription String @db.Text

  philosophyFourthTitle       String
  philosophyFourthDescription String @db.Text

  statsEyebrow String
  statsTitle   String

  ctaEyebrow      String
  ctaTitle        String
  ctaDescription  String  @db.Text
  ctaButtonLabel  String
  ctaImageUrl     String?
  ctaImageFileKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("about_page_content")
}

model FaqPageContent {
  id String @id

  heroEyebrow               String
  heroTitle                 String
  heroDescription           String  @db.Text
  heroHandwrittenFirstLine  String
  heroHandwrittenSecondLine String
  heroImageUrl              String?
  heroImageFileKey          String?

  questionsEyebrow     String
  questionsTitle       String
  questionsDescription String @db.Text

  ctaEyebrow      String
  ctaTitle        String
  ctaDescription  String  @db.Text
  ctaButtonLabel  String
  ctaImageUrl     String?
  ctaImageFileKey String?

  items FaqItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faq_page_content")
}

model FaqItem {
  id String @id @default(cuid())

  question String
  answer   String @db.Text
  position Int    @default(0)

  faqPageContentId String
  faqPageContent   FaqPageContent @relation(fields: [faqPageContentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([faqPageContentId, position])
  @@map("faq_items")
}

model ContactPageContent {
  id String @id

  eyebrow     String
  handwritten String
  title       String
  description String @db.Text

  reassuranceFirstLabel  String
  reassuranceSecondLabel String
  reassuranceThirdLabel  String

  formTitle String

  accommodationSubjectTitle       String
  accommodationSubjectDescription String
  otherSubjectTitle               String
  otherSubjectDescription         String

  accommodationLabel String

  firstNameLabel       String
  firstNamePlaceholder String

  emailLabel       String
  emailPlaceholder String

  messageLabel       String
  messagePlaceholder String

  submitLabel String

  successEyebrow     String
  successTitle       String
  successDescription String @db.Text
  successResetLabel  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_page_content")
}
