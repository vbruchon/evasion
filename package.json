{
  "name": "evasion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --no-hints && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate --no-hints",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:refresh": "pnpm db:reset && pnpm db:generate && pnpm db:seed",
    "test:db:prepare": "dotenv -e .env.test -- prisma migrate deploy",
    "test:db:reset": "dotenv -e .env.test -- prisma migrate reset --force",
    "db:refresh:all": "pnpm db:refresh && pnpm test:db:reset",
    "test": "dotenv -e .env.test -- vitest run",
    "test:watch": "dotenv -e .env.test -- vitest",
    "test:accommodations": "dotenv -e .env.test -- vitest run tests/accommodations",
    "test:reviews": "dotenv -e .env.test -- vitest run tests/reviews",
    "test:about": "dotenv -e .env.test -- vitest run tests/about",
    "test:faq": "dotenv -e .env.test -- vitest run tests/faq",
    "test:contact": "dotenv -e .env.test -- vitest run tests/contact",
    "test:home": "dotenv -e .env.test -- vitest run tests/home",
    "test:legal": "dotenv -e .env.test -- vitest run tests/legal",
    "test:admin": "dotenv -e .env.test -- vitest run tests/admin",
    "test:accommodations-page": "dotenv -e .env.test -- vitest run tests/accommodations-page",
    "test:e2e:prepare": "dotenv -e .env.e2e -- tsx tests/e2e/setup/check-e2e-database.ts && dotenv -e .env.e2e -- prisma generate --no-hints && dotenv -e .env.e2e -- prisma migrate reset --force && dotenv -e .env.e2e -- prisma db seed && dotenv -e .env.e2e -- tsx tests/e2e/setup/create-admin-state.ts",
    "test:e2e": "pnpm test:e2e:prepare && dotenv -e .env.e2e -- playwright test",
    "test:e2e:ui": "pnpm test:e2e:prepare && dotenv -e .env.e2e -- playwright test --ui",
    "security:audit": "pnpm audit --prod --audit-level high --ignore GHSA-ggr8-5vv4-36mx --ignore GHSA-3f6p-5ww8-9rcr",
    "can-commit": "pnpm exec tsc --noEmit && pnpm lint && git diff --check && pnpm test:accommodations && pnpm test:accommodations-page && pnpm test:reviews && pnpm test:about && pnpm test:faq && pnpm test:contact && pnpm test:home && pnpm test:legal && pnpm test:admin"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@marsidev/react-turnstile": "^1.6.1",
    "@prisma/client": "^7.10.0",
    "@react-email/render": "^2.1.0",
    "@uploadthing/react": "^7.3.3",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "csv-parse": "^7.0.2",
    "embla-carousel-react": "^8.6.0",
    "ical.js": "^2.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.28.0",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.86.0",
    "resend": "^6.30.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uploadthing": "^7.7.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pg": "^8.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.0.1",
    "pg": "^8.22.0",
    "prisma": "^7.10.0",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "proxy-addr": "2.0.8",
      "effect": "3.20.0",
      "fast-uri": "3.1.8",
      "source-map-js": "1.2.2",
      "undici": "8.10.2"
    },
    "auditConfig": {
      "ignoreCves": [
        "GHSA-ggr8-5vv4-36mx",
        "GHSA-3f6p-5ww8-9rcr"
      ]
    }
  }
}
